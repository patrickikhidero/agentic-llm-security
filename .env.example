# ── LLM Provider API Key ──────────────────────────────────────────────────────
# Free key from https://console.groq.com — used for the agent's planning LLM.
# Add your key here. Copy this file to .env and never commit .env to git.

GROQ_API_KEY=gsk_...

# ── Model Selection ────────────────────────────────────────────────────────────
# Open-weight model served via Groq's free tier
AGENT_MODEL=openai/gpt-oss-20b

# ── Pipeline Configuration ─────────────────────────────────────────────────────
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=8000
MAX_AGENT_STEPS=15                  # Maximum steps per execution chain
STEP_TIMEOUT_SECONDS=30             # Per-step timeout

# ── ChromaDB (RAG) ─────────────────────────────────────────────────────────────
# Embedded/local persistent store — no separate server process required.
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_BENIGN=enterprise_corpus
CHROMA_COLLECTION_POISONED=poisoned_corpus

# ── Defense Configuration ──────────────────────────────────────────────────────
ENABLE_INPUT_SCREENER=true
ENABLE_GOAL_VERIFIER=true
ENABLE_OUTPUT_VALIDATOR=true
ENABLE_HITL_GATE=false              # Set true for human-in-the-loop mode

# Classifier thresholds (0.0 to 1.0)
INJECTION_DETECTION_THRESHOLD=0.75
GOAL_CONSISTENCY_THRESHOLD=0.80

# ── Evaluation ─────────────────────────────────────────────────────────────────
RESULTS_DIR=data/results
LOG_LEVEL=INFO
