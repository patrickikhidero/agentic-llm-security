# ── LLM Provider API Key ──────────────────────────────────────────────────────
# Free key from https://console.groq.com — used for the agent's planning LLM.
# Add your key here. Copy this file to .env and never commit .env to git.

GROQ_API_KEY=gsk_...

# ── Optional ───────────────────────────────────────────────────────────────────
# Everything else (model, step limits, defense thresholds, trial counts) is set
# in configs/*.yaml, not here.

# Embedded ChromaDB store — no separate server process required.
CHROMA_PERSIST_DIR=data/chroma

LOG_LEVEL=INFO
